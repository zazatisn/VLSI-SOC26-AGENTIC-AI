    .reset(reset),
    .data_in(data_in),
    .detected(detected)
  );

  initial begin
    clk = 0;
  end

  always #0.55 begin
    clk = ~clk;
  end

  initial begin
    in_bits = 16'b0001100110110010;
    exp_bits = 16'b0000010001000000;
    reset = 1;
    data_in = 1;
    
    @(posedge clk);
    @(posedge clk);
    
    @(negedge clk);
    reset = 0;
    
