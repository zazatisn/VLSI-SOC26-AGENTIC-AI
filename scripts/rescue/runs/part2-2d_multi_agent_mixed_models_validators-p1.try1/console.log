[32m[[ ## reasoning ## ]]
1. Clock Generation: Period of 1.1ns requires toggle every 0.55ns.
2. Reset Sequence: Assert reset high for 2 rising edges (up to 2.2ns), release on the falling edge at 2.75ns.
3. Drive/Check Logic: Use `@(negedge clk)` for all operations. The spec requires 16 inputs `0001100110110010`.
4. Protocol:
   - Loop 16 times.
   - At each falling edge:
     - Check `detected` against `sample_output[i]`.
     - Drive `data_in` with `sample_input[i]`.
   - The reset release timing: At t=0, clk=0, reset=1. At t=0.55 (pos), t=1.1 (neg), t=1.65 (pos), t=2.2 (neg). Release reset at t=2.75 (falling edge after 2nd rising edge).
5. Data structures: Use `reg` arrays to hold the `sample_input` and `sample_output` strings for easy iteration.

[[ ## testbench_code ## ]]
module tb;
    reg clk;
    reg reset;
    reg data_in;
    wire detected;

    integer i;
    reg [15:0] inputs = 16'b0001_1001_1011_0010;
    reg [15:0] outputs = 16'b0000_0100_0100_0000;

    seq_detector_0011 dut(
        .clk(clk),
        .reset(reset),
        .data_in(data_in),
        .detected(detected)
    );

    initial clk = 0;
    always #0.55 clk = ~clk;

    initial begin
        reset = 1;
        data_in = 0;
        
        // Wait for 2 rising edges (0.55, 1.65), then release on falling edge (2.75)
        repeat (5) @(negedge clk);
        reset = 0;

        for (i = 0; i < 16; i = i + 1) begin
            @(negedge clk);
            
            if (detected === outputs[15 - i]) begin
                $display("TEST: PASS | Inputs: [data_in=%b] | Expected: [%b] | Output: [%b]", inputs[15 - i], outputs[15 - i], detected);
            end else begin
                $display("TEST: FAIL | Inputs: [data_in=%b] | Expected: [%b] | Output: [%b]", inputs[15 - i], outputs[15 - i], detected);
            end
            
            data_in = inputs[15 - i];
        end

        // Extra cycle to verify final detection
        @(negedge clk);
        
        $finish;
    end
endmodule

