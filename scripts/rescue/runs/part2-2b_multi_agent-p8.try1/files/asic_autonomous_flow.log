            if (exp_res >= 5'd31) begin
                result = {sign, 5'd31, 10'd0};
            end else if (exp_res[5] == 1'b1 || exp_res == 5'd0) begin
                result = {sign, 15'd0};
            end else begin
                result = {sign, exp_res, mantissa[9:0]};
            end
        end
    end
