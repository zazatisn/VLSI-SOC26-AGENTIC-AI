module fp16_multiplier(
    input      [15:0] a,
    input      [15:0] b,
    output reg [15:0] result
);

    reg        sign;
    reg [4:0]  exp_a, exp_b, exp_res;
    reg [10:0] sig_a, sig_b;
    reg [21:0] prod;
    reg [10:0] mantissa;
    reg        guard, round, sticky;
    reg        round_up;
    reg signed [6:0] exp_sum;

    always @(*) begin
        sign = a[15] ^ b[15];
        exp_a = a[14:10];
        exp_b = b[14:10];
        sig_a = {1'b1, a[9:0]};
        sig_b = {1'b1, b[9:0]};

        if (exp_a == 5'd0 || exp_b == 5'd0) begin
            result = {sign, 15'd0};
        end else begin
            prod = sig_a * sig_b;
            exp_sum = exp_a + exp_b - 5'd15;

            // Normalize product: product is 22 bits (bit 21 is MSB).
            // If bit 21 is set (product >= 2), shift right and increment exponent
            if (prod[21]) begin
                mantissa = prod[21:11];
                guard = prod[10];
                round = prod[9];
                sticky = |prod[8:0];
                exp_res = exp_sum + 5'd1;
            end else begin
                mantissa = prod[20:10];
                guard = prod[9];
                round = prod[8];
                sticky = |prod[7:0];
                exp_res = exp_sum;
            end

            // IEEE 754 Round to nearest even
            round_up = guard && (round || sticky || mantissa[0]);

            if (round_up) begin
                mantissa = mantissa + 1'b1;
                if (mantissa[10]) begin
                    mantissa = {1'b1, 10'd0};
                    exp_res = exp_res + 5'd1;
