   - Calculate `prod` (22 bits).
   - If `prod[21]` is set, mantissa is `prod[21:11]`. If not, it's `prod[20:10]` and `exp_sum` is decremented.
   - Rounding to nearest even: `round_up = guard && (round || sticky || mantissa[0])`.
   - After incrementing `mantissa` for rounding, if it overflows (becomes `2.0`), shift right and increment exponent.
   - Handle overflow/underflow cases specifically per spec.
5. The logic is kept purely combinational as per the "timing" requirement.

[[ ## rtl_code ## ]]
module fp16_multiplier(
    input      [15:0] a,
    input      [15:0] b,
    output reg [15:0] result
);

    reg        sign;
    reg [4:0]  exp_a, exp_b;
    reg [10:0] sig_a, sig_b;
    reg [21:0] prod;
    reg [10:0] mantissa;
    reg signed [10:0] exp_sum;
    reg        guard, round, sticky;
    reg        round_up;

    always @(*) begin
        sign = a[15] ^ b[15];
        exp_a = a[14:10];
        exp_b = b[14:10];
        sig_a = {1'b1, a[9:0]};
        sig_b = {1'b1, b[9:0]};
        
        result = 16'b0;

        if (exp_a == 5'd0 || exp_b == 5'd0) begin
            result = {sign, 15'b0};
        end else begin
            prod = sig_a * sig_b;
            exp_sum = $signed({1'b0, exp_a}) + $signed({1'b0, exp_b}) - 10'd15;

            if (prod[21]) begin
                mantissa = prod[21:11];
                guard = prod[10];
                round = prod[9];
                sticky = |prod[8:0];
            end else begin
                mantissa = prod[20:10];
                exp_sum = exp_sum - 1;
                guard = prod[9];
                round = prod[8];
                sticky = |prod[7:0];
            end

            round_up = guard && (round || sticky || mantissa[0]);
            if (round_up) begin
                mantissa = mantissa + 1;
                if (mantissa[10]) begin
                    mantissa = {1'b1, 10'd0};
                    exp_sum = exp_sum + 1;
                end
            end

            if (exp_sum >= 11'd31) begin
                result = {sign, 5'b11111, 10'b0};
            end else if (exp_sum <= 11'd0) begin
                result = {sign, 15'b0};
            end else begin
                result = {sign, exp_sum[4:0], mantissa[9:0]};
            end
        end
    end
endmodule

