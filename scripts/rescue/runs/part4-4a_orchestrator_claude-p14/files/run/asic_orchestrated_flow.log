    always @(posedge clk) begin
        if (reset) begin
            result <= 8'b0;
            zero <= 1'b0;
            carry <= 1'b0;
        end else begin
            result <= next_result;
            zero <= (next_result == 8'b0) ? 1'b1 : 1'b0;
            carry <= next_carry;
        end
    end

