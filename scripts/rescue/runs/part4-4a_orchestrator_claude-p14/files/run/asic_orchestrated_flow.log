module alu_8bit(
    input            clk,
    input            reset,
    input      [7:0] a,
    input      [7:0] b,
    input      [2:0] op,
    output reg [7:0] result,
    output reg       zero,
    output reg       carry
);

    reg [7:0] next_result;
    reg next_carry;

