[[ ## reasoning ## ]]
1.  **State Machine Design**: The sequence "0011" requires states representing the partial match:
    - IDLE (nothing matched)
    - S0 (seen "0")
    - S00 (seen "00")
    - S001 (seen "001")
    - SUCCESS (seen "0011")
    - Transition logic:
      - IDLE + 0 -> S0, IDLE + 1 -> IDLE
      - S0 + 0 -> S00, S0 + 1 -> IDLE
      - S00 + 0 -> S00, S00 + 1 -> S001
      - S001 + 0 -> S0, S001 + 1 -> SUCCESS
      - SUCCESS + 0 -> S0, SUCCESS + 1 -> IDLE
    - Output: HIGH only in SUCCESS state.
2.  **Timing**: The output `detected` must be registered (Moore FSM).
3.  **Testbench**: Follows the race-free protocol: drive inputs on negative edge, check outputs on negative edge. Inputs/Outputs sequence matched per instructions.
4.  **SDC**: Clock is defined as 1.1ns. Sequential design.
5.  **Config**: Small design, so CORE_UTILIZATION set to 20.

[[ ## testbench_code ## ]]
module tb;
    reg clk;
    reg reset;
    reg data_in;
    wire detected;
    integer i;
    reg [15:0] sample_input = 16'b0001100110110010;
    reg [15:0] sample_output = 16'b0000010001000000;

    seq_detector_0011 dut(.clk(clk), .reset(reset), .data_in(data_in), .detected(detected));

    always #0.55 clk = ~clk;

    initial begin
        clk = 0;
        reset = 1;
        data_in = 0;
        #1.1;
        #1.1;
        @(negedge clk) reset = 0;

        for (i = 0; i < 16; i = i + 1) begin
            @(negedge clk);
            if (detected === sample_output[15-i]) 
                $display("TEST: PASS | Inputs: [data_in=%b] | Expected: [%b] | Output: [%b]", sample_input[15-i], sample_output[15-i], detected);
            else 
                $display("TEST: FAIL | Inputs: [data_in=%b] | Expected: [%b] | Output: [%b]", sample_input[15-i], sample_output[15-i], detected);
            data_in = sample_input[15-i];
        end
        $finish;
    end
endmodule

[[ ## rtl_code ## ]]
module seq_detector_0011(
    input clk,
    input reset,
    input data_in,
    output reg detected
);
    localparam IDLE = 3'd0, S0 = 3'd1, S00 = 3'd2, S001 = 3'd3, SUCCESS = 3'd4;
    reg [2:0] state, next_state;

    always @(posedge clk) begin
        if (reset) state <= IDLE;
        else state <= next_state;
    end

    always @(*) begin
        next_state = state;
        detected = 0;
        case (state)
            IDLE: next_state = (data_in == 0) ? S0 : IDLE;
            S0:   next_state = (data_in == 0) ? S00 : IDLE;
            S00:  next_state = (data_in == 0) ? S00 : S001;
            S001: next_state = (data_in == 0) ? S0 : SUCCESS;
            SUCCESS: begin
                detected = 1;
                next_state = (data_in == 0) ? S0 : IDLE;
            end
            default: next_state = IDLE;
        endcase
    end
endmodule

