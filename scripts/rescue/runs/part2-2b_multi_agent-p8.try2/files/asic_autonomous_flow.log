    reg [10:0] mant_norm;
    reg [9:0]  mant_final;
    reg [4:0]  exp_final;
    reg        round_bit;

    always @(*) begin
        // Defaults
        sign = a[15] ^ b[15];
        ea = a[14:10];
        eb = b[14:10];
        ma = {1'b1, a[9:0]};
        mb = {1'b1, b[9:0]};
        prod = ma * mb;
        result = 16'b0;

        if (ea == 5'd0 || eb == 5'd0) begin
