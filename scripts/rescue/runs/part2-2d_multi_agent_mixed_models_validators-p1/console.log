            end
            S_00: begin
                if (data_in == 1'b0) begin
                    next_state = S_00;
                end else begin
                    next_state = S_001;
                end
            end
            S_001: begin
                if (data_in == 1'b0) begin
                    next_state = S_0;
                end else begin
                    next_state = S_0011;
                end
            end
            S_0011: begin
                if (data_in == 1'b0) begin
                    next_state = S_0;
                end else begin
                    next_state = S_IDLE;
                end
            end
            default: begin
                next_state = S_IDLE;
            end
        endcase
    end

endmodule

