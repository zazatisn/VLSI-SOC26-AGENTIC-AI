                         data_in, reset, expected_output[i], detected);
            end
        end

        // Test Back-to-Back: 00110011
        // Resetting to clear state
        reset = 1; @(negedge clk); reset = 0;
        
        // Sequence: 0 0 1 1 0 0 1 1
        // Expected: 0 0 0 1 0 0 0 1
        begin
