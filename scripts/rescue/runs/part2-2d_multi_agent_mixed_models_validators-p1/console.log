            S_0011: begin
                detected = 1'b1;
                if (data_in == 1'b0) begin
                    next_state = S_0;
                end else begin
                    next_state = S_IDLE;
                end
            end
            default: begin
                next_state = S_IDLE;
            end
        endcase
    end

endmodule

