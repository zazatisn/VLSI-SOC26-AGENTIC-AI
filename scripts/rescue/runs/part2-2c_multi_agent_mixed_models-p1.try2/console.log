`timescale 1ns/1ps

module seq_detector_0011(
    input clk,
    input reset,
    input data_in,
    output reg detected
);

    localparam IDLE  = 3'b000;
    localparam S0    = 3'b001;
    localparam S00   = 3'b010;
    localparam S001  = 3'b011;
    localparam S0011 = 3'b100;

    reg [2:0] state;
    reg [2:0] next_state;

    always @(posedge clk) begin
        if (reset) begin
            state <= IDLE;
        end else begin
            state <= next_state;
        end
    end

    always @(*) begin
        next_state = IDLE;
        detected = 1'b0;

        case (state)
            IDLE: begin
                if (data_in == 1'b0) begin
                    next_state = S0;
                end else begin
                    next_state = IDLE;
                end
            end
            S0: begin
                if (data_in == 1'b0) begin
                    next_state = S00;
                end else begin
                    next_state = IDLE;
                end
            end
            S00: begin
                if (data_in == 1'b0) begin
                    next_state = S00;
                end else begin
                    next_state = S001;
                end
            end
            S001: begin
                if (data_in == 1'b0) begin
                    next_state = S0;
                end else begin
                    next_state = S0011;
                end
            end
            S0011: begin
                detected = 1'b1;
                if (data_in == 1'b0) begin
                    next_state = S0;
                end else begin
                    next_state = IDLE;
                end
            end
            default: begin
                next_state = IDLE;
                detected = 1'b0;
            end
        endcase
    end

endmodule

