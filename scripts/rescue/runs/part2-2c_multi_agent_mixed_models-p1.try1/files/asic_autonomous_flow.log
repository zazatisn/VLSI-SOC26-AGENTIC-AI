To detect the sequence "0011" as a Moore machine:
1. Define states based on the progress of matching "0011":
   - IDLE: No match, expecting first '0'
   - S0: Matched '0'
   - S00: Matched '00'
   - S001: Matched '001'
   - S0011: Matched '0011' (Detected)
2. Transitions:
   - IDLE: 0 -> S0, 1 -> IDLE
   - S0: 0 -> S00, 1 -> IDLE
   - S00: 0 -> S00, 1 -> S001
   - S001: 0 -> S0, 1 -> S0011
   - S0011: 0 -> S0, 1 -> IDLE (Wait, for overlap "0011" -> '00110011', the state after S0011 is determined by the last bit. If '0', we check suffix. If '1', we go to IDLE. Actually, if S0011 is reached, we have '0011'. If next is '0', we have '...0', which is S0. If next is '1', we have '...1', which is IDLE).
3. Reset: Synchronous reset returns to IDLE.
4. Output: `detected` is high only in state S0011. This satisfies the Moore machine requirement.

[[ ## rtl_code ## ]]
module seq_detector_0011(
    input clk,
    input reset,
    input data_in,
    output reg detected
);

    localparam IDLE  = 3'b000;
    localparam S0    = 3'b001;
    localparam S00   = 3'b010;
    localparam S001  = 3'b011;
    localparam S0011 = 3'b100;

    reg [2:0] state;
    reg [2:0] next_state;

    always @(posedge clk) begin
        if (reset) begin
            state <= IDLE;
        end else begin
            state <= next_state;
        end
    end

    always @(*) begin
        next_state = state;
        detected = 1'b0;

        case (state)
            IDLE: begin
                if (data_in == 1'b0) begin
                    next_state = S0;
                end else begin
                    next_state = IDLE;
                end
            end
            S0: begin
                if (data_in == 1'b0) begin
                    next_state = S00;
                end else begin
                    next_state = IDLE;
                end
            end
            S00: begin
                if (data_in == 1'b0) begin
                    next_state = S00;
                end else begin
                    next_state = S001;
                end
            end
            S001: begin
                if (data_in == 1'b0) begin
                    next_state = S0;
                end else begin
                    next_state = S0011;
                end
            end
            S0011: begin
                detected = 1'b1;
                if (data_in == 1'b0) begin
                    next_state = S0;
                end else begin
                    next_state = IDLE;
                end
            end
            default: begin
                next_state = IDLE;
            end
        endcase
    end

endmodule

