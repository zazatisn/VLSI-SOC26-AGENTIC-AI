    always @(posedge clk) begin
        if (rst) begin
            dot_out <= {2*WIDTH+4{1'b0}};
        end else begin
            sum_reg = {2*WIDTH+4{1'b0}};
            for (i = 0; i < N; i = i + 1) begin
