
# Personal API keys (never commit)
scripts/api_keys.sh

# Python caches
__pycache__/
*.pyc

# Run outputs of the flows (Parts 2-4) and Part 1 simulation output
scripts/part*/*/runs/
scripts/part1/**/sim_out
*.log
# ...but keep the logs of the recorded rescue runs (console.log is what show_rescue.py replays)
!scripts/rescue/runs/**/*.log

# Local development archive and reference repositories
scripts/part2/_dev_archive/
tests/
# Build outputs of reference/make_reference.py (the generated pN.json files ARE committed)
scripts/reference/p*/build/
